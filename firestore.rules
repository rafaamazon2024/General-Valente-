rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (Auth UID)
    // Fields:
    //   - email: string (required) - User email
    //   - displayName: string (optional) - User name
    //   - photoURL: string (optional) - User photo
    //   - alert_time: string (optional) - Settings
    //   - alerts_enabled: bool (optional) - Settings
    //   - created_at: string (ISO date-time)
    //   - fcmTokens: list (optional) - Web Push tokens do dispositivo, gerenciados pelo próprio client
    //   - streak_days / dias_sem_cumprir / total_points / punishment_active: escritos SOMENTE pelas
    //     Cloud Functions via Admin SDK (que ignora estas regras) - o client nunca pode alterá-los.
    //
    // Collection: daily_checkins (doc id: "{uid}_{YYYY-MM-DD}") - escrito só pelas Cloud Functions
    //   - uid, date, status ('pending'|'completed_yes'|'completed_no'|'auto_resolved_no'), responded_at
    //
    // Subcollection: users/{userId}/medals (doc id: auto) - escrito só pelas Cloud Functions
    //   - granted_at, reason
    //
    // Collection: records
    // Document ID: recordId (Auto-generated)
    // Fields:
    //   - uid: string (required) - Owner UID
    //   - area_id: string (required) - Area identifier
    //   - type: string (required) - Item type (livro, curso, etc.)
    //   - data: map (required) - Dynamic fields
    //   - created_at: string (ISO date-time)
    //   - updated_at: string (ISO date-time)
    //
    // Collection: exercicios (Biblioteca de Exercícios, área Saúde & Fitness)
    //   - uid, nome, grupo_muscular, link_video, created_at, updated_at
    //
    // Collection: treino_logs (doc id: "{uid}_{YYYY-MM-DD}")
    //   - uid, date, grupos: list, exercicios_feitos: list, completo: bool, updated_at
    //
    // Collection: habito_logs (doc id: "{uid}_{YYYY-MM-DD}") - check-in diário de hábitos
    //   (registros de qualquer área com type=='habito'), usado pela seção "Hoje" da Visão Geral.
    //   - uid, date, habitos_feitos: list (ids de records), updated_at
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "rafa.araujo.27@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email']) &&
             data.email is string &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('alert_time' in data) || data.alert_time is string) &&
             (!('alerts_enabled' in data) || data.alerts_enabled is bool) &&
             (!('fcmTokens' in data) || data.fcmTokens is list);
    }

    // Campos de progresso/punição só podem ser alterados pelas Cloud Functions (Admin SDK,
    // que ignora estas regras) - bloqueia qualquer escrita direta do client a esses campos.
    function progressFieldsLocked() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['streak_days', 'dias_sem_cumprir', 'total_points', 'punishment_active']
      );
    }

    function isValidRecord(data) {
      return data.keys().hasAll(['uid', 'area_id', 'type', 'data']) &&
             data.uid == request.auth.uid &&
             data.area_id is string &&
             data.type is string &&
             data.data is map &&
             data.data.keys().size() > 0;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) &&
                      !request.resource.data.keys().hasAny(
                        ['streak_days', 'dias_sem_cumprir', 'total_points', 'punishment_active']
                      );
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.email == resource.data.email && // Email is immutable
                      progressFieldsLocked();
      allow delete: if isAdmin();

      match /medals/{medalId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // só Cloud Functions (Admin SDK ignora esta regra)
      }
    }

    match /records/{recordId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidRecord(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) &&
                      isValidRecord(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid; // Cannot transfer ownership
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /daily_checkins/{checkinId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false; // só Cloud Functions (Admin SDK ignora esta regra)
    }

    match /exercicios/{exercicioId} {
      // resource == null cobre o `get` de um documento que ainda não existe (ex.: tentativa de
      // leitura por ID antes de qualquer criação) - sem esse check, resource.data em documento
      // inexistente derruba a regra com permission-denied em vez de "não encontrado".
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /treino_logs/{logId} {
      // Doc id é "{uid}_{date}" e só passa a existir quando o usuário marca o primeiro exercício
      // do dia - o onSnapshot em useTreinoHoje faz `get` desse doc desde o primeiro carregamento
      // da aba, quando ele ainda não existe. resource == null evita permission-denied nesse caso.
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) &&
                      request.resource.data.uid == resource.data.uid;
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /habito_logs/{logId} {
      // Mesmo padrão do treino_logs: doc "{uid}_{date}" só existe a partir do primeiro check-in
      // do dia, então o `get` inicial precisa do resource == null pra não virar permission-denied.
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) &&
                      request.resource.data.uid == resource.data.uid;
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
